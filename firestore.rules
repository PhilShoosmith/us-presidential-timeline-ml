rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{docId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /leaderboard/{docId}/{document=**} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}
